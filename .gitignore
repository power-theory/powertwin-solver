data/
# but keep the surrogate source package that happens to be named data/
!surrogate/app/modules/data/
!surrogate/app/modules/data/**
# ...except its compiled bytecode, which the negation above would otherwise re-track
surrogate/app/modules/data/**/__pycache__/
# ...and the synthetic leaf-dataset generator the test suite runs (its out/ stays
# ignored via tests/data/.gitignore); the blanket data/ rule had hidden it from CI
!tests/data/
!tests/data/**
tests/data/**/__pycache__/
*.egg-info/
powertwin_data
postgres_data
.github/instructions
.github/prompts
*.log
.claude
CLAUDE.md

