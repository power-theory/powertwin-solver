  <class_name>SetLightingPowerDensity</class_name>
  <display_name>Set Lighting Power Density</display_name>
  <description>Scale interior lighting so the building-average installed LPD equals target_w_per_ft2.</description>
  <modeler_description>Computes the building lighting power, then multiplies every Lights instance multiplier by target x area / current so the building-average installed lighting power density equals target_w_per_ft2 (W/ft2). Preserves the space-by-space distribution; exterior lights untouched.</modeler_description>
  <arguments>
    <argument>
      <name>target_w_per_ft2</name>
      <display_name>Target building-average lighting power density</display_name>
      <type>Double</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>0</default_value>
    </argument>
  </arguments>
